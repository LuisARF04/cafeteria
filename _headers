# Cloudflare Pages — cabeceras
#
# Lo importante aquí es la caché: con internet lento, que el teléfono
# no vuelva a bajar el CSS y el JS en cada visita es la diferencia
# entre abrir al instante o esperar.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), interest-cohort=()

# Las páginas se revalidan siempre: así un arreglo llega enseguida.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/admin.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

# CSS y JS: se piden con ?v=N desde el HTML, así que una versión concreta
# nunca cambia y se puede guardar mucho tiempo. Al subir un cambio se sube
# el número de versión en index.html y admin.html, y el teléfono baja el
# archivo nuevo de inmediato en vez de esperar a que caduque la caché.
/assets/*
  Cache-Control: public, max-age=604800
